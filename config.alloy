// nagomi-core
local.file_match "nagomi_core_logs" {
	path_targets = [{ "__path__" = "/var/log/nagomi-core.log" }]
}

loki.source.file "nagomi_core" {
	targets       = local.file_match.nagomi_core_logs.targets
	forward_to    = [loki.process.nagomi_core.receiver]
	tail_from_end = false
}

loki.process "nagomi_core" {
	stage.json {
		expressions = {
			timestamp    = "time",
			level        = "level",
			prefix       = "prefix",
			error        = "err",
			user_id      = "user_id",
			procedure    = "procedure",
			duration_ms  = "duration_ms",
			status       = "status",
			path         = "path",
		}
	}
	stage.timestamp {
		source   = "timestamp"
		format   = "2006/01/02 15:04:05"
		location = "America/Toronto"
	}
	stage.static_labels {
		values = { app = "nagomi-core" }
	}
	stage.labels {
		values = {
			level     = "level",
			prefix    = "prefix",
			user_id   = "user_id",
			procedure = "procedure",
			status    = "status",
		}
	}
	forward_to = [loki.write.default.receiver]
}


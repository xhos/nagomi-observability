// null-gateway
local.file_match "null_gateway_logs" {
	path_targets = [{ "__path__" = "/var/log/null-gateway.log" }]
}

loki.source.file "null_gateway" {
	targets       = local.file_match.null_gateway_logs.targets
	forward_to    = [loki.process.null_gateway.receiver]
	tail_from_end = false
}

loki.process "null_gateway" {
	stage.json {
		expressions = {
			timestamp   = "time",
			level       = "level",
			error       = "err",
			method      = "method",
			path        = "path",
			duration_ms = "duration_ms",
			status      = "status",
		}
	}
	stage.timestamp {
		source = "timestamp"
		format = "RFC3339Nano"
	}
	stage.static_labels {
		values = { app = "null-gateway" }
	}
	stage.labels {
		values = {
			level  = "level",
			method = "method",
			status = "status",
		}
	}
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
